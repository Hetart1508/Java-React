{
  "info": {
    "name": "Finance Manager Java API",
    "description": "Postman collection for testing the Java servlet finance transactions API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "transactionId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Get All Transactions",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/transactions",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "transactions"
          ]
        }
      }
    },
    {
      "name": "Get Transactions With Filters",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/transactions?type=EXPENSE&category=Food&date=2026-07-03",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "transactions"
          ],
          "query": [
            {
              "key": "type",
              "value": "EXPENSE"
            },
            {
              "key": "category",
              "value": "Food"
            },
            {
              "key": "date",
              "value": "2026-07-03"
            }
          ]
        }
      }
    },
    {
      "name": "Get Transaction By ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/transactions/{{transactionId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "transactions",
            "{{transactionId}}"
          ]
        }
      }
    },
    {
      "name": "Get Summary",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/transactions/summary",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "transactions",
            "summary"
          ]
        }
      }
    },
    {
      "name": "Create Transaction",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Gym Membership\",\n  \"amount\": 45.00,\n  \"type\": \"EXPENSE\",\n  \"category\": \"Health\",\n  \"date\": \"2026-07-09\",\n  \"description\": \"Monthly gym membership fee\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/transactions",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "transactions"
          ]
        }
      }
    },
    {
      "name": "Update Transaction Full",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Updated Gym Membership\",\n  \"amount\": 50.00,\n  \"type\": \"EXPENSE\",\n  \"category\": \"Health\",\n  \"date\": \"2026-07-09\",\n  \"description\": \"Updated monthly gym membership fee\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/transactions/{{transactionId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "transactions",
            "{{transactionId}}"
          ]
        }
      }
    },
    {
      "name": "Patch Transaction Partial",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount\": 55.00,\n  \"description\": \"Partial update test from Postman\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/transactions/{{transactionId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "transactions",
            "{{transactionId}}"
          ]
        }
      }
    },
    {
      "name": "Delete Transaction",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/transactions/{{transactionId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "transactions",
            "{{transactionId}}"
          ]
        }
      }
    }
  ]
}
